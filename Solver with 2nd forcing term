clear; clc;

%% Parameters
U0 = 20;
Lx = 100000;
H  = 800;
Nx = 16384;
Nz = 101;

x  = linspace(0, Lx, Nx);
z  = linspace(0, H,  Nz);
dz = z(2) - z(1);

%% Turbine forcing f_x(x,z)
A    = 0.5;
x1   = Lx/4;      % Turbine 1 location (rename x0 -> x1)
z0   = 150;
sigx = 50;
sigz = 40;

[X,Z] = meshgrid(x, z);

%% Spacing values
S_list = [25, 50, 100];  

%% Wavenumbers corresponding to FFT ordering
kvec = (2*pi/Lx) * [0:(Nx/2-1), -Nx/2:-1];

%% Loop over spacings
for is = 1:length(S_list)

    S  = S_list(is);
    x2 = x1 + S;          % Turbine 2 location

    %% Both forcing components
    fx1 = -A .* exp(-(X-x1).^2/(2*sigx^2)) .* ...
                exp(-(Z-z0).^2/(2*sigz^2));

    fx2 = -A .* exp(-(X-x2).^2/(2*sigx^2)) .* ...
                exp(-(Z-z0).^2/(2*sigz^2));

    fx = fx1 + fx2; %%Total forcing

    
    fz = fx .* (-(Z - z0)/sigz^2);

   
    fz_hat = fft(fz, [], 2);
    w_hat  = zeros(Nz, Nx);

    
    for ik = 1:Nx
        k = kvec(ik);
        rhs = -1i * k * fz_hat(:,ik);

        L = zeros(Nz, Nz);

        % Bottom BC: w(0) = 0  -> w_1 = 0
        L(1,1) = 1;
        rhs(1) = 0;

        % Interior points
        for j = 2:Nz-1
            L(j,j-1) =  U0/dz^2;
            L(j,j)   = -2*U0/dz^2 - U0*k^2;
            L(j,j+1) =  U0/dz^2;
        end

        % Top BC: w_z(H) = 0
        L(Nz,Nz)   =  1;
        L(Nz,Nz-1) = -1;
        rhs(Nz)    =  0;

        w_hat(:,ik) = L \ rhs;
    end

    
    w = real(ifft(w_hat, [], 2));

    %% Calculate u(x,z)
    Wz = zeros(Nz, Nx);

    for ix = 1:Nx
        dwdz = zeros(Nz,1);
        dwdz(2:Nz-1) = (w(3:Nz,ix) - w(1:Nz-2,ix)) / (2*dz);
        dwdz(1)      = (w(2,ix) - w(1,ix)) / dz;
        dwdz(Nz)     = 0;
        Wz(:,ix)     = dwdz;
    end

    u = zeros(Nz, Nx);
    for j = 1:Nz
        u(j,:) = -cumtrapz(x, Wz(j,:));
    end

    %% Plot spacings
    figure;
    imagesc(x/1000, z, u);
    set(gca,'YDir','normal');
    xlim([(x1-300)/1000, (x2+300)/1000]);
    xlabel('x (km)');
    ylabel('z (m)');
    title(sprintf('Horizontal velocity disturbance u(x,z), spacing S = %g m', S));
    colorbar;

    hold on;
    plot([x1 x1]/1000, [0 H], 'k--', 'LineWidth', 1.5);
    plot([x2 x2]/1000, [0 H], 'r--', 'LineWidth', 1.5);
    hold off;

end


 


